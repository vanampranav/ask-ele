# Copy this file to `.env` (same folder) and fill in your key.
#   cp ask_ele/.env.example ask_ele/.env

# Use the Gemini API (Google AI Studio) — simplest for testing. Keep this FALSE.
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Get a free key at https://aistudio.google.com/apikey and paste it here.
# (Newer ADK also accepts GEMINI_API_KEY — either works.)
GOOGLE_API_KEY=PASTE_YOUR_KEY_HERE

# --- To use Vertex AI instead of the AI Studio key (optional, later) ---
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-gcp-project-id
# GOOGLE_CLOUD_LOCATION=us-central1
# (then run: gcloud auth application-default login)
